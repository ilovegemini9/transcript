  "seoRules": {
    "emitHreflangOnlyFor": "published",
    "includeXDefault": true,
    "canonicalMustBeSelfReferential": true,
    "requireReciprocalAlternates": true
  },
  "routing": {
    "localePrefix": "always-for-non-default",
    "englishDefault": "/",
    "blogIndexPattern": "/{locale}/{localizedSlugs.blog}/",
    "articlePattern": "/{locale}/{localizedSlugs.blog}/{localizedSlugs.articles[englishArticleKey]}/",
    "slugPolicy": "Use translated human-readable slugs; never expose untranslated English slugs on localized pages.",
    "hreflangPolicy": "Emit only when every alternate page in the cluster exists, is indexable, self-canonical, and reciprocally links to all others."
  }
